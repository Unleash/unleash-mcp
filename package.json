{
  "name": "@unleash/mcp",
  "version": "1.0.0-alpha.0",
  "description": "MCP server for Unleash: an AI-agent-friendly interface to Unleash",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "bin": {
    "unleash-mcp": "dist/src/index.js"
  },
  "exports": {
    "./remote": {
      "types": "./dist/src/remote.d.ts",
      "import": "./dist/src/remote.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node src/index.ts",
    "typecheck": "tsc",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "test": "node --env-file=.env --test",
    "test:record": "UNLEASH_SNAPSHOT_MODE=record node --env-file=.env --test",
    "spec:update": "curl -sSf https://sandbox.getunleash.io/enterprise/docs/openapi.json -o src/unleash/openapi.json && pnpm spec:generate",
    "spec:generate": "openapi-typescript src/unleash/openapi.json -o src/unleash/api.d.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "microdiff": "^1.6.0",
    "openapi-fetch": "^0.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "undici": "^8.12.3"
  }
}
