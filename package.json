{
  "name": "@unleash/mcp",
  "version": "2.0.0-alpha.0",
  "description": "MCP server for Unleash: an AI-agent-friendly interface to Unleash",
  "type": "module",
  "bin": {
    "unleash-mcp": "src/index.ts"
  },
  "scripts": {
    "start": "node src/index.ts",
    "typecheck": "tsc",
    "test": "tsc && node --env-file=.env --test",
    "test:record": "UNLEASH_SNAPSHOT_MODE=record node --env-file=.env --test",
    "spec:update": "curl -sSf https://sandbox.getunleash.io/enterprise/docs/openapi.json -o src/unleash/openapi.json && npm run spec:generate",
    "spec:generate": "openapi-typescript src/unleash/openapi.json -o src/unleash/api.d.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "openapi-fetch": "^0.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "undici": "^8.12.3"
  }
}
