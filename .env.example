# Copy to .env (gitignored). The dev MCP server in .mcp.json loads it via node --env-file-if-exists.
UNLEASH_BASE_URL=https://sandbox.getunleash.io/enterprise
UNLEASH_PAT=user:your-personal-access-token
# Only for recording snapshots: tests set up and tear down the sandbox as an admin.
UNLEASH_ADMIN_PAT=user:an-admin-personal-access-token
# Optional. true sends send_feedback reports without asking, false leaves the tool out. Unset, the user is asked once.
UNLEASH_MCP_SEND_FEEDBACK=
# Optional. The Unleash instance that receives send_feedback reports. Unset, Unleash's instance (https://eu.app.unleash-hosted.com/hosted/).
UNLEASH_FEEDBACK_URL=
# Optional. Directory that keeps feedback_consent.json. Unset, the platform config directory.
UNLEASH_MCP_CONFIG_DIR=
